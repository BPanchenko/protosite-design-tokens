{
	"$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
	"shadow": {
		"1dp": {
			"$type": "shadow",
			"$value": [
				{
					"offset": [0, 0],
					"blur": 0.2,
					"color": "color(from var(--fgcolor) xyz x y z / 0.14)"
				}, {
					"offset": [0, 0.2],
					"blur": 0.2,
					"color": "color(from var(--fgcolor) xyz x y z / 0.12)"
				}, {
					"offset": [0, 0.1],
					"blur": 0.3,
					"spread": -0.2,
					"color": "color(from var(--fgcolor) xyz x y z / 0.2)"
				}
			]
		},
		"2dp": {
			"$type": "shadow",
			"$value": [
				{
					"offset": [0, 0],
					"blur": 0.4,
					"color": "color(from var(--fgcolor) xyz x y z / 0.14)"
				}, {
					"offset": [0, 0.3],
					"blur": 0.4,
					"color": "color(from var(--fgcolor) xyz x y z / 0.12)"
				}, {
					"offset": [0, 0.1],
					"blur": 0.5,
					"spread": -0.2,
					"color": "color(from var(--fgcolor) xyz x y z / 0.2)"
				}
			]
		},
		"3dp": {
